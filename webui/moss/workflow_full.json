{
  "_note": "MOSS-Image 精修档（50 步 · CFG3 · SLG 跳层 22）原生 ComfyUI 工作流；无 LoRA、无采样补丁节点（shift 5 由核心内置）。SLG 只作用于负向分支，故 CFG>1 时才有意义。",
  "1": {"class_type": "UNETLoader",
        "inputs": {"unet_name": "moss_image_sft_int8_convrot.safetensors", "weight_dtype": "default"}},
  "2": {"class_type": "CLIPLoader",
        "inputs": {"clip_name": "qwen3.5_9b_w4a8_gptq.safetensors", "type": "moss_image", "device": "default"}},
  "3": {"class_type": "VAELoader",
        "inputs": {"vae_name": "flux2-vae_small.safetensors"}},
  "4": {"class_type": "CLIPTextEncode",
        "inputs": {"text": "{{prompt}}", "clip": ["2", 0]}},
  "5": {"class_type": "CLIPTextEncode",
        "inputs": {"text": "{{negative}}", "clip": ["2", 0]}},
  "6": {"class_type": "EmptyFlux2LatentImage",
        "inputs": {"width": "{{width}}", "height": "{{height}}", "batch_size": "{{batch}}"}},
  "13": {"class_type": "SkipLayerGuidanceDiTSimple",
        "inputs": {"model": ["1", 0], "double_layers": "", "single_layers": "{{slg_skip_layer}}",
                    "start_percent": "{{slg_start}}", "end_percent": "{{slg_end}}"}},
  "16": {"class_type": "KSampler",
        "inputs": {"model": ["13", 0], "positive": ["4", 0], "negative": ["5", 0], "latent_image": ["6", 0],
                   "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}",
                   "sampler_name": "euler", "scheduler": "sgm_uniform", "denoise": 1}},
  "17": {"class_type": "VAEDecode", "inputs": {"samples": ["16", 0], "vae": ["3", 0]}},
  "18": {"class_type": "SaveImage", "inputs": {"images": ["17", 0], "filename_prefix": "{{prefix}}"}}
}
