{
  "_note": "环境清单：换电脑 clone 代码后，壳按这份清单体检并一键补齐缺的依赖与权重。加依赖/换模型改这里，不用改代码。",
  "python": { "min": "3.11", "max": "3.13", "best": "3.12" },
  "indexes": {
    "pypi": "https://mirrors.aliyun.com/pypi/simple/",
    "aliyun": "https://mirrors.aliyun.com/pypi/simple/",
    "torch": "https://download.pytorch.org/whl/cu128"
  },
  "packages": [
    { "name": "torch", "version": "2.11.0", "index": "torch", "cuda": true,
      "note": "必须走 cu128 索引：PyPI 默认轮子是 CPU 版，装了也出不了图" },
    { "name": "torchvision", "version": "0.26.0", "index": "torch",
      "note": "Qwen3VL 图像预处理硬依赖" },
    { "name": "torchao", "version": "0.18.0", "index": "pypi",
      "note": "fp8 量化通路，12G 卡靠它" },
    { "name": "transformers", "version": "5.19.0", "min": "5.17", "index": "pypi" },
    { "name": "diffusers", "commit": "916a5791ed5f29d966200d2eee53f06862ec4434",
      "repo": "https://github.com/huggingface/diffusers.git",
      "note": "QwenImage21Pipeline 只在开发版里有；钉死 commit 保证可复现。github 直连不稳时先开代理再补这一项" },
    { "name": "accelerate", "version": "1.15.0", "index": "pypi" },
    { "name": "huggingface-hub", "version": "2.2.0", "index": "pypi",
      "note": "模型下载器（hf-mirror 断点续传）" },
    { "name": "pillow", "version": "12.3.0", "index": "pypi" },
    { "name": "numpy", "version": "2.5.4", "index": "pypi" },
    { "name": "pywebview", "version": "6.2.1", "index": "pypi",
      "note": "桌面壳本体" },
    { "name": "websocket-client", "version": "1.8.0", "index": "pypi", "group": "Moss 环境",
      "note": "Moss 走内嵌 ComfyUI：/ws 实时步数进度靠它；不装则回落成完成轮询（不影响出图）" },
    { "name": "fastapi", "version": "0.143.0", "index": "pypi", "optional": true,
      "note": "设置页里的 API 服务用；不装也能生图" },
    { "name": "uvicorn", "version": "0.54.0", "index": "pypi", "optional": true },
    { "name": "python-multipart", "version": "0.0.32", "index": "pypi", "optional": true }
  ],
  "models": [
    {
      "key": "turbo",
      "label": "主力模型 Turbo",
      "repo": "Qwen/Qwen-Image-2.1-Turbo",
      "dir": "models/Qwen-Image-2.1-Turbo",
      "default_active": true,
      "gb": 30.3,
      "must": {
        "model_index.json": 578,
        "processor/chat_template.jinja": 5292,
        "processor/processor_config.json": 1300,
        "processor/tokenizer.json": 11422650,
        "processor/tokenizer_config.json": 705,
        "scheduler/scheduler_config.json": 486,
        "text_encoder/config.json": 1542,
        "text_encoder/generation_config.json": 241,
        "text_encoder/model.safetensors": 17534340584,
        "transformer/config.json": 370,
        "transformer/diffusion_pytorch_model.safetensors.index.json": 30283,
        "transformer/diffusion_pytorch_model-00001-of-00002.safetensors": 9968332504,
        "transformer/diffusion_pytorch_model-00002-of-00002.safetensors": 4261951904,
        "vae/config.json": 2172,
        "vae/diffusion_pytorch_model.safetensors": 675508656
      }
    }
  ],
  "moss": {
    "_note": "Moss 生图走内嵌 ComfyUI 子进程（独立 venv，与千问那套 .venv 互不干扰）。换电脑一键补全会：clone ComfyUI → 建 comfyui/.venv 装它自己的依赖 → 用主 venv 的 hf-mirror 下载器把 MOSS-Image 权重灌进 comfyui/models。native 支持自 ComfyUI v0.42.0（PR#17095，2026-10-16 合入）起进入核心。",
    "comfyui": {
      "repo": "https://github.com/Comfy-Org/ComfyUI.git",
      "branch": "v0.42.1",
      "dir": "comfyui",
      "min_commit": "e087d8f6cb7c6cdb11b59dc7c9bf17c79f8d877d",
      "note": "branch 可用 v0.42.1（已含 MOSS-Image）或 master；换版本只改这里",
      "torch_index": "https://download.pytorch.org/whl/cu130",
      "torch_note": "内嵌 ComfyUI 的 torch 单独指索引：MOSS-Image 的权重是 int8_convrot / w4a8_gptq，跑它们的 CUDA 内核要 cu130+（ComfyUI 的 comfy/quant_ops.py 在 torch.version.cuda < 13 时把整套 kitchen CUDA 后端 disable 掉，只能走 eager 反量化）。实测同一张 12G 卡：cu128 热 512²/8 步 4.3 秒 → cu130 0.9 秒。千问那套照旧走 indexes.torch 的 cu128，不受这里影响。"
    },
    "venv": { "dir": "comfyui/.venv", "requirements": "comfyui/requirements.txt" },
    "models": [
      {
        "key": "moss-comfy",
        "label": "MOSS-Image 权重（Comfy-Org）",
        "repo": "Comfy-Org/MOSS-Image",
        "dir": "comfyui/models",
        "gb": 13.01,
        "must": {
          "diffusion_models/moss_image_sft_int8_convrot.safetensors": 5413698958,
          "text_encoders/qwen3.5_9b_w4a8_gptq.safetensors": 7343591088,
          "vae/flux2-vae_small.safetensors": 249521340
        }
      },
      {
        "key": "moss-lora",
        "label": "8 步 DMD LoRA（Kromoss）",
        "repo": "lodestones/Kromoss",
        "dir": "comfyui/models/loras",
        "allow": ["8-steps-dmd2-lora.safetensors"],
        "gb": 1.1,
        "must": {
          "8-steps-dmd2-lora.safetensors": 1189176800
        },
        "_note": "只下 workflow_fast.json 里钉死的那一个：两个 DMD 变体都下要多花 1.1GB，而极速档用不到第二个"
      }
    ]
  },
  "dirs": [
    { "path": "outputs", "note": "成图输出目录" },
    { "path": "data", "note": "历史库（删了不丢图，只是丢收藏与参数回填）" },
    { "path": "logs", "note": "运行日志" }
  ]
}
